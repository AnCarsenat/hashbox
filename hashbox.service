[Unit]
Description=hashbox (data-in-link paste/URL + webhook relay)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/hashbox
Environment=HASHBOX_BIND=0.0.0.0:8080
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=64M

[Install]
WantedBy=multi-user.target
